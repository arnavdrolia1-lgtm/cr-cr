# ==============================================================================
# AutoSpec Database Configuration Example
# Copy this file to `.streamlit/secrets.toml` or paste into Streamlit Cloud Secrets
# ==============================================================================

# --- Option 1: TiDB Cloud Serverless (RECOMMENDED FOR STREAMLIT COMMUNITY CLOUD) ---
# 1. Sign up for free at https://tidbcloud.com (No credit card needed)
# 2. Create a Serverless Cluster (MySQL compatible)
# 3. Copy the connection credentials here:
#
# [mysql]
# host = "gateway01.ap-southeast-1.prod.aws.tidbcloud.com"
# port = 4000
# user = "xxxxxx.root"
# password = "your-tidb-password"
# database = "AutoSpec_Database_System"
# ssl_verify_cert = true

# --- Option 2: AWS RDS MySQL ---
# [mysql]
# host = "autospec-db.c7xxxxxx.us-east-1.rds.amazonaws.com"
# port = 3306
# user = "admin"
# password = "your-rds-password"
# database = "AutoSpec_Database_System"

# --- Option 3: Local MySQL Server (Default fallback if secrets.toml is omitted) ---
[mysql]
host = "localhost"
port = 3306
user = "root"
password = "your-root-password"
database = "AutoSpec_Database_System"
